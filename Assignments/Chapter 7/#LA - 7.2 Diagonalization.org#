from sympy import *

A = Matrix([
    [-1, -1, 0],
    [0, -5, 0],
    [-2, 0, -4]
])

P = Matrix([
    [0, 1, -3],
    [0, 4, 0],
    [1, 2, 2]
])

solution = Inverse(P) * A * P
print(latex(solution))
